{
  "name": "music-downloader-functions",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions:music-downloader",
    "gcp-build": "bash scripts/fetch-binaries.sh"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "node-id3": "^0.2.9",
    "ytmusic-api": "^5.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~6.0.2",
    "vitest": "^5.0.5"
  }
}
