{
  "name": "music-downloader-functions",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "local": "npm run build && node lib/local/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions:music-downloader",
    "gcp-build": "bash scripts/fetch-binaries.sh",
    "test:emulators": "firebase emulators:exec --config ../firebase.json --only firestore --project demo-music-downloader 'vitest run -c vitest.emulator.config.ts'"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "node-id3": "^0.2.9",
    "ytmusic-api": "^5.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^22.20.5",
    "firebase": "^13.0.0",
    "firebase-tools": "^15.34.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.5"
  }
}
