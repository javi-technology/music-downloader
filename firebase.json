{
  "functions": [
    {
      "source": "functions",
      "codebase": "music-downloader",
      "runtime": "nodejs22",
      "ignore": ["node_modules", ".git", "src", "bin", "**/*.spec.*", "*.local"],
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
    }
  ],
  "firestore": [
    {
      "database": "music-downloader",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    }
  ],
  "storage": [
    {
      "target": "music-downloader",
      "rules": "storage.rules"
    }
  ],
  "hosting": [
    {
      "target": "music-downloader",
      "predeploy": ["npm --prefix web run build"],
      "public": "web/dist/web/browser",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [{ "source": "**", "destination": "/index.html" }]
    }
  ],
  "emulators": {
    "auth": { "port": 9099 },
    "functions": { "port": 5001 },
    "firestore": { "port": 8080 },
    "storage": { "port": 9199 },
    "hosting": { "port": 5002 },
    "ui": { "enabled": true }
  }
}
